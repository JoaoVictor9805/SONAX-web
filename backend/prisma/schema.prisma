generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model avaliacao_ia {
  log                   String            @id @db.VarChar(255)
  data_avaliacao        DateTime          @db.Date
  modelo_ia             String            @db.VarChar(50)
  ligacao_relevante     String            @db.VarChar(1)
  conversa_decisor      String            @default("n") @db.VarChar(1)
  reuniao_confirmada    String            @db.VarChar(1)
  resultado_frase       String
  registro_chamadas     registro_chamadas @relation(fields: [log], references: [log], onDelete: NoAction, onUpdate: NoAction)
  avaliacao_sdr         avaliacao_sdr?
  detalhes_interlocutor interlocutor?

  @@index([data_avaliacao], map: "idx_avaliacao_ia_data")
}

model avaliacao_sdr {
  log                      String       @id @db.VarChar(255)
  nota_final               Int?
  feedback_geral           String
  frase_alternativa        String?
  validacao_dor            String?
  contato_inicial          String?
  isolamento_objecao       String?
  qualidade_investigacao   String?
  acertos                  String?
  melhorias                String?
  nota_abertura            Int?
  justificativa_abertura   String?
  nota_spin                Int?
  justificativa_spin       String?
  nota_perfil              Int?
  justificativa_perfil     String?
  nota_bant                Int?
  justificativa_bant       String?
  nota_escuta              Int?
  justificativa_escuta     String?
  nota_prox_passo          Int?
  justificativa_prox_passo String?
  frase_original           String?
  avaliacao_ia             avaliacao_ia @relation(fields: [log], references: [log], onDelete: Cascade, onUpdate: NoAction)

  @@index([nota_final], map: "idx_avaliacao_sdr_nota")
}

model chamadas {
  protocolo           BigInt             @id
  estado_ddd          String?            @db.VarChar(3)
  numero              String?            @db.VarChar(20)
  atendido            String?            @db.Char(1)
  ramal               String?            @db.VarChar(20)
  duracao_segundos    Int?
  fila_id             Int?
  fila_descricao      String?            @db.VarChar(150)
  tabulacao_id        Int?
  tabulacao_descricao String?            @db.VarChar(150)
  agente_login        String?            @db.VarChar(50)
  agente_nome         String?            @db.VarChar(100)
  campanha_id         Int?
  campanha_descricao  String?            @db.VarChar(150)
  dt_inicio           DateTime?          @db.Timestamp(6)
  dt_fim              DateTime?          @db.Timestamp(6)
  status              String?            @db.VarChar(50)
  hash_registro       String?            @db.VarChar(64)
  last_sync           DateTime?          @db.Timestamp(6)
  registros_chamadas  registro_chamadas?

  @@index([agente_nome, dt_inicio], map: "idx_chamadas_agente_data")
}

model interlocutor {
  log                 String       @id @db.VarChar(255)
  interesse_expresso  String?
  duvidas             String?
  objecoes            String?
  resposta_sdr        String?
  reacao_interlocutor String?
  avaliacao_ia        avaliacao_ia @relation(fields: [log], references: [log], onDelete: Cascade, onUpdate: NoAction)
}

model registro_chamadas {
  log          String        @id @db.VarChar(255)
  protocolo    BigInt        @unique
  transcricao  String?
  avaliacao_ia avaliacao_ia?
  chamada_info chamadas      @relation(fields: [protocolo], references: [protocolo], onDelete: Cascade, onUpdate: NoAction, map: "fk_registro_chamada")
}

model agentes {
  id_agente           Int                   @id @default(autoincrement())
  agente_login        String                @unique @db.VarChar(50)
  agente_nome         String                @db.VarChar(100)
  id_departamento     Int?
  ativo               Boolean?              @default(true)
  criado_em           DateTime?             @default(now()) @db.Timestamp(6)
  departamentos       departamentos?        @relation(fields: [id_departamento], references: [id_departamento], onUpdate: NoAction)
  perfis_consolidados perfis_consolidados[]
}

model departamentos {
  id_departamento     Int                   @id @default(autoincrement())
  nome                String                @unique @db.VarChar(100)
  ativo               Boolean?              @default(true)
  criado_em           DateTime?             @default(now()) @db.Timestamp(6)
  agentes             agentes[]
  perfis_consolidados perfis_consolidados[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model perfis_consolidados {
  id_perfil            Int            @id @default(autoincrement())
  tipo_escopo          String         @db.VarChar(20)
  granularidade        String         @db.VarChar(10)
  ano                  Int
  mes                  Int
  semana_do_mes        Int?
  data_inicio          DateTime       @db.Date
  data_fim             DateTime       @db.Date
  id_agente            Int?
  id_departamento      Int?
  metricas_camada_1    Json
  metricas_camada_2    Json
  diagnostico_camada_3 Json
  evidencias_camada_4  Json
  processado_em        DateTime?      @default(now()) @db.Timestamp(6)
  parecer_executivo    String?
  agentes              agentes?       @relation(fields: [id_agente], references: [id_agente], onDelete: Cascade, onUpdate: NoAction)
  departamentos        departamentos? @relation(fields: [id_departamento], references: [id_departamento], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tipo_escopo, granularidade, ano, mes, semana_do_mes, id_agente, id_departamento])
  @@index([tipo_escopo, granularidade, data_inicio, id_agente, id_departamento], map: "idx_perfis_filtros")
}
